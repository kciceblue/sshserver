{
  "openapi": "3.1.0",
  "info": {
    "title": "Just Another Terminal Sync API",
    "version": "1.0.0-review-draft",
    "description": "Task 2.0 review-pending API. It is reachable only through an SSH-forwarded loopback listener and is not approved for shipping."
  },
  "x-jat-error-status-map": {
    "invalid_request": 400,
    "unsupported_protocol": 426,
    "unsupported_capability": 426,
    "unauthorized": 401,
    "token_revoked": 401,
    "scope_denied": 403,
    "authenticated_device_mismatch": 403,
    "rate_limited": 429,
    "grant_expired": 410,
    "grant_consumed": 410,
    "enrollment_replay_mismatch": 409,
    "request_id_reused": 409,
    "generation_conflict": 409,
    "generation_exhausted": 409,
    "counter_conflict": 409,
    "counter_exhausted": 409,
    "revision_equivocation": 409,
    "too_many_siblings": 409,
    "limit_exceeded": 413,
    "cursor_expired": 410,
    "envelope_missing": 404,
    "device_not_found": 404,
    "snapshot_not_found": 404,
    "snapshot_expired": 410,
    "stale_after_collection": 409,
    "zero_active_confirmation_required": 409,
    "instance_mismatch": 409,
    "server_cursor_exhausted": 507,
    "internal_error": 500
  },
  "servers": [
    {
      "url": "http://127.0.0.1:37421",
      "description": "Loopback endpoint reached through a verified SSH local forward"
    }
  ],
  "paths": {
    "/v1/healthz": {
      "get": {
        "operationId": "getHealth",
        "security": [],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "responses": {
          "200": {
            "description": "Service is ready",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/health_response"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "security": [],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "responses": {
          "200": {
            "description": "Exact protocol and capability range",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/capabilities_response"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/enrollments": {
      "post": {
        "operationId": "createEnrollment",
        "description": "Transactional enrollment. A valid replacement grant with the exact retained enrollment tuple recovers a recorded success without creating or updating a second device.",
        "security": [{"enrollmentGrant": []}],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "schemas/wire.schema.json#/$defs/enrollment_request"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Device enrolled",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/enrollment_response"}
              }
            }
          },
          "200": {
            "description": "Exact-tuple recovery of the recorded result with no device state change",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/enrollment_response"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "410": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "507": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/vault-envelope": {
      "get": {
        "operationId": "getVaultEnvelope",
        "security": [{"deviceBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "responses": {
          "200": {
            "description": "Current wrapped VMK envelope",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/vault_envelope"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"}
        }
      },
      "put": {
        "operationId": "putVaultEnvelope",
        "description": "Conditional cursor-bearing envelope creation or replacement. After expected_generation matches, a stored generation of UInt64.max returns non-retryable 409 generation_exhausted before successor/envelope semantic validation and before cursor capacity; otherwise a new commit at server cursor UInt64.max returns 507 server_cursor_exhausted. Either failure occurs before mutation. An exact idempotent retry returns the recorded result and consumes no second cursor.",
        "security": [{"deviceBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "schemas/wire.schema.json#/$defs/put_envelope_request"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Envelope generation committed",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/vault_envelope"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "507": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/sync": {
      "post": {
        "operationId": "syncVault",
        "description": "Draft2 record revisions carry a required nullable collection_witness_authenticator. Null explicitly denies use as a collection witness; an honest client emits a 32-byte HMAC only for a tombstone or a revision that strictly dominates its complete durable same-record frontier. The null/non-null kind and present bytes are bound into record AEAD associated data. A marker requires the witness revision's exact non-null HMAC. The server stores opaque authenticators and enforces structural vector/counter and collection ordering rules; clients verify non-null revision and marker authenticators and include every verified monotonic per-record marker frontier in later mutation causal context. A mutation that does not strictly dominate the current marker frontier returns 409 stale_after_collection.",
        "security": [{"deviceBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "schemas/wire.schema.json#/$defs/sync_request"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Atomic mutation/ack commit followed by one ordered page",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/sync_response"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "410": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "507": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/snapshot-reads": {
      "post": {
        "operationId": "createSnapshotRead",
        "description": "The request must declare exactly the canonical sorted required-capability quartet authenticated-collection-frontiers-v2, snapshot-collection-markers-v1, snapshot-device-registry-v1, and snapshot-read-v1. Missing, incomplete, duplicate, additional, or noncanonical declarations return 426 unsupported_capability before snapshot allocation. The snapshot contains at most one monotonic exact-witness marker per record, keyed and ordered by record_id; witness revision ID, vector, and authenticator are copied exactly while barrier_cursor remains unauthenticated operational metadata. An exact device/request-ID retry returns the existing snapshot without refreshing its lease or consuming rate/capacity. New unique requests are limited to 5 per rolling minute per device, 1 active snapshot per device, 8 active snapshots per instance, and 67108864 bytes of active snapshot metadata per instance. Rate excess returns 429 rate_limited; count or metadata excess returns 413 limit_exceeded before metadata allocation or revision-object retention. Creation copies the envelope, marker/device projection, membership, and paging metadata while retaining content-addressed references to existing immutable revision payloads; it never duplicates full-vault payload bytes or pins live device rows.",
        "security": [{"deviceBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "schemas/wire.schema.json#/$defs/snapshot_create_request"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stable recovery-complete snapshot cut and first page token created; requires authenticated-collection-frontiers-v2, snapshot-read-v1, snapshot-collection-markers-v1, and snapshot-device-registry-v1",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/snapshot_create_response"}
              }
            }
          },
          "200": {
            "description": "Idempotent recovery-complete snapshot creation retry; requires authenticated-collection-frontiers-v2, snapshot-read-v1, snapshot-collection-markers-v1, and snapshot-device-registry-v1",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/snapshot_create_response"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "413": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/snapshot-reads/{snapshot_id}/pages": {
      "post": {
        "operationId": "readSnapshotPage",
        "description": "Authenticates the bearer against current live device state before reading immutable snapshot storage. Revocation is never delayed by a snapshot lease; a revoked snapshot owner receives 401 token_revoked.",
        "security": [{"deviceBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/ProtocolVersion"},
          {"$ref": "#/components/parameters/RequestID"},
          {
            "name": "snapshot_id",
            "in": "path",
            "required": true,
            "schema": {"$ref": "schemas/wire.schema.json#/$defs/uuid"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "schemas/wire.schema.json#/$defs/snapshot_page_request"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "One stable phase page containing retained undominated revisions, persistent collection markers, or complete source-device registry entries in key order; requires authenticated-collection-frontiers-v2, snapshot-read-v1, snapshot-collection-markers-v1, and snapshot-device-registry-v1",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/snapshot_page_response"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "410": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/devices": {
      "get": {
        "operationId": "listDevices",
        "security": [{"deviceBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "responses": {
          "200": {
            "description": "Server-visible device registry",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/devices_response"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/devices/{device_id}/revoke": {
      "post": {
        "operationId": "revokeDevice",
        "description": "Cursor-bearing durable revocation. Live device state changes immediately and is never blocked by a snapshot lease. A new revocation at server cursor UInt64.max returns 507 server_cursor_exhausted before mutation. Self-revocation retains its request ID, exact authenticated raw-body fingerprint, pre-revocation token hash, and byte-equivalent 200 response for the life of the retired row. On this endpoint only, receipt lookup precedes ordinary revoked-token rejection: that same revoked bearer may retrieve only the exact committed self-revocation response when target device, JAT-Request-ID, body request ID, and exact raw body all match after the bearer is matched to the retired row. Any mismatch returns 401 token_revoked without receipt detail; beyond the constant-time retired-receipt row lookup, the path performs no general device, vault, ciphertext, snapshot, or lease read, no mutation or authority grant, and no timing or lifetime refresh. Other exact idempotent retries return the recorded device result without consuming another cursor.",
        "security": [{"deviceBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/ProtocolVersion"},
          {"$ref": "#/components/parameters/RequestID"},
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {"$ref": "schemas/wire.schema.json#/$defs/uuid"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "schemas/wire.schema.json#/$defs/revoke_device_request"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device durably revoked",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/device"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "404": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"},
          "507": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/device-token-rotations": {
      "post": {
        "operationId": "rotateDeviceToken",
        "description": "Self-only, non-cursor-bearing token-hash replacement: request device_id must equal the bearer-authenticated device or HTTP 403 authenticated_device_mismatch is returned before mutation. It remains available at server cursor UInt64.max.",
        "security": [{"deviceBearer": []}],
        "parameters": [{"$ref": "#/components/parameters/ProtocolVersion"}, {"$ref": "#/components/parameters/RequestID"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "schemas/wire.schema.json#/$defs/token_rotation_request"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token hash replaced or equivalent retry confirmed",
            "content": {
              "application/json": {
                "schema": {"$ref": "schemas/wire.schema.json#/$defs/device"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/Error"},
          "401": {"$ref": "#/components/responses/Error"},
          "403": {"$ref": "#/components/responses/Error"},
          "409": {"$ref": "#/components/responses/Error"},
          "426": {"$ref": "#/components/responses/Error"},
          "429": {"$ref": "#/components/responses/Error"},
          "500": {"$ref": "#/components/responses/Error"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "deviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "32 random bytes encoded as unpadded base64url"
      },
      "enrollmentGrant": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "JAT-Enrollment followed by a short-lived 32-byte grant"
      }
    },
    "parameters": {
      "ProtocolVersion": {
        "name": "JAT-Protocol-Version",
        "in": "header",
        "required": true,
        "schema": {"const": "1"}
      },
      "RequestID": {
        "name": "JAT-Request-ID",
        "in": "header",
        "required": true,
        "schema": {"$ref": "schemas/wire.schema.json#/$defs/uuid"}
      }
    },
    "responses": {
      "Error": {
        "description": "Stable redaction-safe error",
        "content": {
          "application/json": {
            "schema": {"$ref": "schemas/wire.schema.json#/$defs/error_response"}
          }
        }
      }
    }
  }
}
