  "exclusions": [
    {
      "id": "conformance-tool",
      "reason": "The root conformance/ tree is a frozen local KAT fixture program rather than a shipped server input boundary; its deterministic vectors remain covered by make kat."
    },
    {
      "id": "stdlib-cli-flags-and-static-templates",
      "reason": "flag.FlagSet and text/template parse source-controlled declarations and templates. Reflection splits only source-controlled Go struct tags. External installer URL, payload, and runtime path values are fuzzed through InstallCommand and validateInstallerRenderOptions."
    },
    {
      "id": "validated-derived-path-and-listener-consumers",
      "reason": "Redundant filepath and host/port operations in store, server, service-manager, and filesystem traversal code consume paths or listener settings already accepted by the inventoried config, deployment-path, or service-definition owners; the source calls remain counted so a new file or call still fails closed. Directory-component walkers retain deterministic filesystem tests in addition to the pure lexical fuzz owner."
    },
    {
      "id": "scanner-entrypoints",
      "reason": "There is no production bufio.Scanner constructor at this revision. The zero-count scanner_constructor signal is retained so adding one changes the exact derived inventory and fails closed."
    },
    {
      "id": "tests-and-vendored-runtime",
      "reason": "Test helpers and runtime/third_party are not project-owned shipping parsers; vendored dependency source remains governed by the repository dependency and license policy."
    }
  ]
}
